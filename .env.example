# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Groq API Key for server-side AI Legal Intake proxy (Server-only secret)
GROQ_API_KEY=your-groq-api-key-here
# Optional: override primary and fallback Groq models (server-only)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional development flag: display local demo advocate fixtures when live database has 0 published profiles
NEXT_PUBLIC_ENABLE_DEMO_LAWYERS=false
