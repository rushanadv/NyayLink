# Supabase Configuration
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only service role secret (required for administrative account deletion & user provisioning)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq API Key for server-side AI Preconsultation proxy (Server-only secret)
GROQ_API_KEY=your-groq-api-key-here
# Optional: override primary and fallback Groq models (server-only)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Official Public Support Email (Rendered on /support, /privacy, and footer)
NEXT_PUBLIC_SUPPORT_EMAIL=support@nyay.live

# Apple App Review / Sandbox Demo Authentication
# Set ENABLE_DEMO_LOGIN=true in production/Vercel to permit Apple App Reviewers to authenticate via /reviewer
ENABLE_DEMO_LOGIN=true
DEMO_CLIENT_EMAIL=demo.client@nyay.live
DEMO_CLIENT_PASSWORD=your-secure-demo-client-password
DEMO_LAWYER_EMAIL=demo.lawyer@nyay.live
DEMO_LAWYER_PASSWORD=your-secure-demo-lawyer-password

# Optional development flag: display local demo advocate fixtures when live database has 0 published profiles
NEXT_PUBLIC_ENABLE_DEMO_LAWYERS=false
