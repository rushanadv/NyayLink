# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# OpenRouter API Key for server-side AI Legal Intake proxy (Server-only secret)
OPENROUTER_API_KEY=your-openrouter-key-here
# Optional: override primary and fallback OpenRouter models (server-only)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional development flag: display local demo advocate fixtures when live database has 0 published profiles
NEXT_PUBLIC_ENABLE_DEMO_LAWYERS=false
